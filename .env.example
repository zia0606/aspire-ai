# Aspire AI cloud accounts / persistence
# Use the pooled Postgres connection string from your Neon project.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000

# Optional: add these to enable real AI responses.
# Without them, Aspire AI automatically uses its built-in local career coach.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.4
